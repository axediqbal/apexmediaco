# ──────────────────────────────────────────────────────────────
# APEX MEDIA CO — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in values.
#   cp .env.example .env.local
#
# If MONGODB_URI is omitted, the app runs in high-fidelity
# in-memory fallback mode with pre-seeded luxury collateral kits.
# ──────────────────────────────────────────────────────────────

# MongoDB Connection String (Optional — app works without it)
# ─── Local MongoDB ───
# MONGODB_URI=mongodb://localhost:27017/apex-media-co

# ─── MongoDB Atlas (Free M0 Cluster) ───
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apex-media-co?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────────
# Optional: Node Environment
# ──────────────────────────────────────────────────────────────
# NODE_ENV=production
