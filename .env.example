# ──────────────────────────────────────────────────────────────
# APEX MEDIA CO — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in values.
#   cp .env.example .env.local
#
# If MONGODB_URI is omitted, the app runs in high-fidelity
# in-memory fallback mode with pre-seeded luxury collateral kits.
# ──────────────────────────────────────────────────────────────

# MongoDB Connection String (Optional — app works without it)
# ─── Local MongoDB ───
# MONGODB_URI=mongodb://localhost:27017/apex-media-co

# ─── MongoDB Atlas (Free M0 Cluster) ───
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apex-media-co?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────────
# Optional: Node Environment
# ──────────────────────────────────────────────────────────────
# NODE_ENV=production

# ──────────────────────────────────────────────────────────────
# Admin API Key (REQUIRED in production)
# ──────────────────────────────────────────────────────────────
# GET /api/orders is admin-only and fails closed: without this key,
# every list-orders request is rejected with 401. Generate one with:
#   openssl rand -hex 32
# Then send it as the `x-admin-key` header when listing orders.
# ──────────────────────────────────────────────────────────────
# ADMIN_API_KEY=change-me-to-a-random-32-byte-hex-string
